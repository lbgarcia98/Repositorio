@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a id="manage" class="nav-link app-user-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Cuenta">
            <i class="mdi mdi-account-circle-outline"></i>
            @UserManager.GetUserName(User)
        </a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button id="logout" type="submit" class="nav-link btn btn-link app-logout">
                <i class="mdi mdi-logout"></i>
                Salir
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link app-user-link" id="register" asp-area="Identity" asp-page="/Account/Register">Registro</a>
    </li>
    <li class="nav-item">
        <a class="nav-link app-user-link" id="login" asp-area="Identity" asp-page="/Account/Login">Ingresar</a>
    </li>
}
</ul>
