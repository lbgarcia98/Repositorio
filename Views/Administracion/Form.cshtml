@model ProyectoUniversidad.Models.AdminFormViewModel

@{
    ViewData["Title"] = $"{Model.Mode} {Model.Entity.SingularName}";
}

<section class="form-page">
    <div class="form-header">
        <div>
            <span class="section-kicker">@Model.Entity.PluralName</span>
            <h1>@Model.Mode @Model.Entity.SingularName</h1>
            <p>@Model.Entity.Description</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-entity="@Model.Entity.Key">
            <i class="mdi mdi-arrow-left"></i>
            Volver
        </a>
    </div>

    <form class="app-form" asp-action="@Model.ActionName" asp-route-entity="@Model.Entity.Key" asp-route-id="@Model.KeyValue" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            @foreach (var field in Model.Fields)
            {
                var value = Model.Values.TryGetValue(field.Name, out var fieldValue) ? fieldValue : string.Empty;
                <div class="form-field @(field.IsBoolean ? "form-field-toggle" : string.Empty)">
                    @if (field.IsBoolean)
                    {
                        <input type="hidden" name="@field.Name" value="false" />
                        <label class="toggle-field">
                            <input class="form-check-input" type="checkbox" name="@field.Name" value="true" checked="@(value == "true")" />
                            <span>
                                <strong>@field.Label</strong>
                                <small>Marca esta opcion cuando el registro este activo o disponible.</small>
                            </span>
                        </label>
                    }
                    else
                    {
                        <label class="form-label" for="@field.Name">@field.Label</label>
                        <input class="form-control" id="@field.Name" name="@field.Name" type="@field.InputType" value="@value" required="@field.IsRequired" />
                        <span class="field-hint">@field.Name</span>
                    }
                    <span class="text-danger" data-valmsg-for="@field.Name" data-valmsg-replace="true"></span>
                </div>
            }
        </div>

        <div class="form-actions">
            <button class="btn btn-primary" type="submit">
                <i class="mdi mdi-content-save"></i>
                Guardar
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-entity="@Model.Entity.Key">Cancelar</a>
        </div>
    </form>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
